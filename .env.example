# Base de datos Turso (obligatorias)
# En Vercel se configuran en: Project Settings -> Environment Variables
# Obtenerlas con:  turso db show <nombre-base> --url
#                  turso db tokens create <nombre-base>
TURSO_DATABASE_URL="libsql://<nombre-base>-<usuario>.turso.io"
TURSO_AUTH_TOKEN=""

# Primer usuario del login. Solo se usan si la tabla "usuarios" esta vacia:
# al primer inicio de sesion se crea este usuario. Luego cambie la contrasena
# desde "Mi cuenta -> Cambiar contrasena" y puede borrar estas dos variables.
ADMIN_USUARIO=""
ADMIN_CONTRASENA=""

# Opcional: clave para firmar las sesiones. Si se deja vacia se usa TURSO_AUTH_TOKEN.
SESSION_SECRET=""

# Correo (Gmail) para "¿Olvidó su contraseña?": se envía una clave temporal al usuario.
# GMAIL_CLAVE_APLICACION es una "contraseña de aplicación" de 16 letras, NO la contraseña
# normal de Gmail. Se crea en https://myaccount.google.com/apppasswords (requiere tener
# activada la verificación en dos pasos en esa cuenta).
GMAIL_USUARIO=""
GMAIL_CLAVE_APLICACION=""
# Opcional: nombre del remitente que ve quien recibe el correo
CORREO_REMITENTE="COAC Once de Junio"
